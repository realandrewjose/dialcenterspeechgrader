{
  "name": "symposium-research-grading-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.js",
  "description": "A comprehensive grading application for public speaking presentations",
  "author": "Symposium Team",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build",
    "build-electron": "cross-env BUILD_TYPE=electron vite build",
    "preview": "vite preview",
    "start": "node server.js",
    "serve": "node server.js",
    "electron-dev": "npm run build-electron && electron .",
    "electron-dev-watch": "concurrently \"vite\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron-build": "npm run build-electron && cross-env CSC_IDENTITY_AUTO_DISCOVERY=false npx electron-builder --win --dir"
  },
  "build": {
    "appId": "com.symposium.grading",
    "productName": "Public Speaking Grader",
    "directories": {
      "buildResources": "public",
      "output": "release"
    },
    "files": [
      "dist",
      "electron",
      "package.json"
    ],
    "extraMetadata": {
      "main": "electron/main.js"
    },
    "win": {
      "target": [
        "portable"
      ]
    }
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.1",
    "autoprefixer": "^10.4.27",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^40.6.1",
    "electron-builder": "^26.8.1",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.2.1",
    "vite": "^8.0.0-beta.13",
    "wait-on": "^9.0.4"
  },
  "overrides": {
    "vite": "^8.0.0-beta.13"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.1.4",
    "express": "^4.18.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  }
}
